# Set a unique value of at least 32 characters before starting.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_FROM_OPENSSL_RAND_HEX_32
APP_ENV=production
WEB_HOST=0.0.0.0
WEB_PORT=5812
# Use HTTPS reverse proxy plus WEB_SECURE_COOKIES=true for public admin access.
WEB_SECURE_COOKIES=false
WEB_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Docker host publication (loopback by default), native systemd uses SOCKS_HOST.
OSGATE_HOST_SOCKS_BIND=127.0.0.1
SOCKS_HOST=0.0.0.0
SOCKS_PORT=1080
SOCKS_MAX_CONNECTIONS=1000
SOCKS_CONNECT_TIMEOUT=15
SOCKS_IDLE_TIMEOUT=600
DATABASE_URL=sqlite:////data/osgate.db
SSH_DIRECTORY=/ssh
SSH_HOSTKEYS_DIRECTORY=/data/ssh-hostkeys
SSH_CONNECT_TIMEOUT=10
SSH_KEEPALIVE_INTERVAL=15
SSH_KEEPALIVE_COUNT_MAX=3
SSH_RECONNECT_INITIAL_DELAY=2
SSH_RECONNECT_MAX_DELAY=60
HEALTH_CHECK_INTERVAL=15
HEALTH_CHECK_TIMEOUT=5
HEALTH_FAILURE_THRESHOLD=3
HEALTH_SUCCESS_THRESHOLD=2
HEALTH_DNS_ENABLED=false
HEALTH_DNS_TEST_HOST=example.com
TRAFFIC_RETENTION_DAYS=7
HEALTH_TEST_HOST=1.1.1.1
HEALTH_TEST_PORT=443
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
TZ=Europe/Moscow
